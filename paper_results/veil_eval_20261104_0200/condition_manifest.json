        "finalize_track"
      ]
    },
    "no_blur_fallback": {
      "config": "ENABLE_FALLBACK_BLUR=False",
      "function": "finalize_track; failed/ineligible uncached faces remain UNPROCESSED"
    },
    "no_identity_lock": {
      "config": "IDENTITY_LOCK_ENABLED=False",
      "function": "prepare_track; skip temporal lock branch",
      "retained": [
        "get_track_embedding cache",
        "BoT-SORT",
        "stable-ID association"
      ]
    },
    "no_mouth_paste": {
      "config": "ENABLE_MOUTH_PASTE=False before import",
      "function": "FaceSwapper original-mouth compositing guard"
    },
    "no_swap_cache": {
      "config": "ENABLE_SWAP_CACHE=False",
      "function": "main disables swap_patch_cache writes and paste_cached_swap reads"
    },
    "selective_blur_only": {
      "config": "ENABLE_FACE_SWAP=False",
      "function": "main skips swapper and cache read; finalize_track blurs background"
    }
  },
  "no_identity_lock_note": "embedding cache, tracking and stable-ID association remain; not frame-independent",
